{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-react.com/contracts/presentation/slide.schema.json",
  "title": "Presentation slide",
  "$defs": {
    "manifest": {"$ref": "material-manifest.schema.json"},
    "rasterMaterial": {
      "type": "object", "additionalProperties": false, "required": ["data_uri", "manifest"],
      "properties": {"data_uri": {"type": "string", "pattern": "^data:image/(png|jpeg);base64,"}, "manifest": {"$ref": "#/$defs/manifest"}}
    },
    "svgMaterial": {
      "type": "object", "additionalProperties": false, "required": ["data_uri", "manifest"],
      "properties": {"data_uri": {"type": "string", "pattern": "^data:image/svg\\+xml;base64,"}, "manifest": {"$ref": "#/$defs/manifest"}}
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "subtitle": {"type": "string", "maxLength": 240}
  },
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["layout", "title", "photo"], "properties": {"layout": {"const": "hero_photo"}, "title": {"$ref": "#/$defs/title"}, "subtitle": {"$ref": "#/$defs/subtitle"}, "caption": {"type": "string", "maxLength": 120}, "photo": {"$ref": "#/$defs/rasterMaterial"}}},
    {"type": "object", "additionalProperties": false, "required": ["layout", "title", "photos"], "properties": {"layout": {"const": "photo_collage"}, "title": {"$ref": "#/$defs/title"}, "subtitle": {"$ref": "#/$defs/subtitle"}, "photos": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["material", "caption"], "properties": {"material": {"$ref": "#/$defs/rasterMaterial"}, "caption": {"type": "string", "maxLength": 80}}}}}},
    {"type": "object", "additionalProperties": false, "required": ["layout", "title", "points"], "properties": {"layout": {"const": "geo_route_map"}, "title": {"$ref": "#/$defs/title"}, "subtitle": {"$ref": "#/$defs/subtitle"}, "map": {"$ref": "#/$defs/rasterMaterial"}, "attribution": {"type": "string", "maxLength": 120}, "points": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["name", "longitude", "latitude", "side"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 60}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}, "latitude": {"type": "number", "minimum": -90, "maximum": 90}, "side": {"enum": ["europe", "asia"]}, "detail": {"type": "string", "maxLength": 100}}}}}},
    {"type": "object", "additionalProperties": false, "required": ["layout", "title", "items"], "properties": {"layout": {"const": "icon_facts"}, "title": {"$ref": "#/$defs/title"}, "subtitle": {"$ref": "#/$defs/subtitle"}, "items": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["icon", "title", "detail"], "properties": {"icon": {"$ref": "#/$defs/svgMaterial"}, "title": {"type": "string", "minLength": 1, "maxLength": 60}, "detail": {"type": "string", "maxLength": 120}}}}}},
    {"type": "object", "additionalProperties": false, "required": ["layout", "title", "quote", "attribution", "photo"], "properties": {"layout": {"const": "quote_photo"}, "title": {"$ref": "#/$defs/title"}, "quote": {"type": "string", "minLength": 1, "maxLength": 260}, "attribution": {"type": "string", "maxLength": 120}, "photo": {"$ref": "#/$defs/rasterMaterial"}}},
    {"type": "object", "additionalProperties": false, "required": ["layout", "title", "metric", "unit", "body", "facts"], "properties": {"layout": {"const": "data_story"}, "title": {"$ref": "#/$defs/title"}, "subtitle": {"$ref": "#/$defs/subtitle"}, "metric": {"type": "string", "maxLength": 16}, "unit": {"type": "string", "maxLength": 16}, "body": {"type": "string", "maxLength": 280}, "facts": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "maxLength": 120}}}},
    {"type": "object", "additionalProperties": false, "required": ["layout", "title", "events"], "properties": {"layout": {"const": "timeline"}, "title": {"$ref": "#/$defs/title"}, "subtitle": {"$ref": "#/$defs/subtitle"}, "events": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["title"], "properties": {"label": {"type": "string", "maxLength": 24}, "title": {"type": "string", "maxLength": 60}, "detail": {"type": "string", "maxLength": 120}}}}}}
  ]
}
