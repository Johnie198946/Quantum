{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-react.com/contracts/workflow/structured-review.schema.json",
  "title": "Structured review document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "fields", "values"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "type": {"enum": ["text", "textarea", "choice", "number", "toggle"]},
          "required": {"type": "boolean"},
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        }
      }
    },
    "values": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
