{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-react.com/contracts/workflow/structured-review-v2.schema.json",
  "title": "Structured review document v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "fields", "values"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "type": {"enum": ["text", "textarea", "choice", "number", "toggle", "list", "page_structure", "asset"]},
          "required": {"type": "boolean"},
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        }
      }
    },
    "values": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "oneOf": [
          {"type": ["string", "number", "boolean", "null"]},
          {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 2000}},
          {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
                "title": {"type": "string", "minLength": 1, "maxLength": 300},
                "summary": {"type": "string", "maxLength": 2000}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "url"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
              "name": {"type": "string", "minLength": 1, "maxLength": 300},
              "url": {"type": "string", "format": "uri", "maxLength": 2000},
              "source_url": {"type": "string", "format": "uri", "maxLength": 2000},
              "mime_type": {"type": "string", "maxLength": 160},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "license": {"type": "string", "maxLength": 300}
            }
          }
        ]
      }
    }
  }
}
