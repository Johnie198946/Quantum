{
  "timezone": "Asia/Shanghai",
  "daily_release_time": "12:00:00",
  "test_serial": true,
  "free_subscription": true,
  "editorial_selection": {
    "genres": ["tutorial", "research_report", "popular_science", "feature", "critical_essay"],
    "candidate_sources": ["follow_builders", "authorized_wiki", "published_catalog", "open_research_gaps"],
    "destinations": ["ai-history", "ai-practice", "concept-fables", "ai-toolkit", "quantumn-originals"],
    "publish_nothing_when_no_reader_value": true,
    "required_brief": true
  },
  "series": [
    {
      "id": "ai-history",
      "title": "AI的前世今生",
      "editorial_mode": "historical_causal_narrative",
      "audience": "非技术中文读者"
    },
    {
      "id": "ai-practice",
      "title": "趣味AI落地经历",
      "editorial_mode": "evidence_led_practical_tutorial",
      "audience": "非技术中文读者"
    },
    {
      "id": "concept-fables",
      "title": "概念寓言",
      "editorial_mode": "delayed_reveal_allegory_with_explicit_mapping",
      "audience": "非技术中文读者"
    },
    {
      "id": "ai-toolkit",
      "title": "AI工具实战",
      "editorial_mode": "novice_step_by_step_tool_building_tutorial",
      "audience": "希望用AI完成工作并开发小工具的入门读者"
    }
  ],
  "original_collections": [
    {
      "id": "anthropic-originals",
      "title": "Anthropic 原作",
      "daily_slot": false,
      "requires_source_publication_id": true,
      "requires_verified_redistribution_evidence": true
    },
    {
      "id": "quantumn-originals",
      "title": "Quantumn 原创书籍",
      "daily_slot": false,
      "requires_source_publication_id": true,
      "requires_local_owner_policy_evidence": true,
      "requires_editorial_contract": true
    }
  ],
  "writer_job": {
    "schedule": "0 8,14,18 * * *",
    "no_agent": false,
    "prompt_template": "docs/prompts/quantumn-editorial-v2.md",
    "per_series_max_issue_count": 1
  },
  "tutorial_supply": {
    "collection_schedule": "0 1 * * *",
    "collection_contract": "success_when_at_least_one_usable_candidate_exists",
    "collection_category_coverage": "optional_per_issue",
    "collection_receipt_deadline": "02:00:00",
    "wiki_compilation_window": {
      "starts_after_collection_receipt": true,
      "target_complete_by": "03:00:00",
      "blocks_authoring": false,
      "truth_states": ["saved", "queued", "compiled"]
    },
    "author_input_freeze_time": "08:05:00",
    "author_input_precedence": [
      "current_cycle_candidates_compiled_to_canonical_wiki",
      "existing_authorized_current_canonical_wiki"
    ],
    "author_must_not_read_collection_receipt_as_content": true,
    "author_schedule": "5 8,14,18 * * *",
    "minimum_usable_candidates": 1,
    "category_coverage_is_optional": true,
    "all_candidates_must_compile": false,
    "collection_success_requires_one_usable_candidate": true,
    "author_reuses_existing_knowledge_gateway": true,
    "direct_vault_read_forbidden": true,
    "current_cycle_compilation_is_preferred_not_required": true,
    "unselected_candidate_failure_blocks_issue": false,
    "sequence": ["collect", "publish_content_available_receipt", "writer_compiles_canonical_wiki", "author_queries_knowledge_gateway", "freeze_publication_inputs", "review", "finalize", "release", "reader_readback"]
  },
  "release_job": {
    "schedule": "0 12 * * *",
    "no_agent": true,
    "command": "scripts/publication_release_remote.py",
    "finalize_native_review_before_release": true
  },
  "editorial_contract": {
    "protocol": "editorial-v2",
    "prompt": "docs/prompts/quantumn-editorial-v2.md",
    "automatic_format": "chapter",
    "book_min_effective_cjk": 20000,
    "book_min_chapters": 8,
    "chapter_min_effective_cjk": 3000,
    "max_failed_reviews_per_issue": 3,
    "legacy_published": "preserve_immutable_body_and_label_article",
    "legacy_pending": "new_contract_and_review_required",
    "proof": "native-editorial-review-v1",
    "semantic_review_required": true
  },
  "reviewer_job": {
    "schedule": "0,30 10,16,20 * * *",
    "no_agent": false,
    "prompt_template": "docs/prompts/quantumn-editorial-v2.md",
    "input_command": "scripts/publication_editorial_remote.py review-input",
    "max_items_per_session": 1
  },
  "release_retry_job": {
    "schedule": "15 12,17,21 * * *",
    "no_agent": true,
    "command": "scripts/publication_release_remote.py"
  }
}
